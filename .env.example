# Copy this file to .env and fill in your values.
# .env is gitignored and will not be committed.

# Required: OpenAI API key for generation
OPENAI_API_KEY=

# Optional: model for chat completions (default: gpt-4o or similar)
# OPENAI_MODEL=gpt-4o

# Optional: Google Service Account for Submission Spreadsheet
# Keep the real JSON beside .env as ./google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
