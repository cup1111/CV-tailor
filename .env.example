# Copy this file to .env and fill in your values.
# .env is gitignored and will not be committed.

# Required: OpenAI API key for generation
OPENAI_API_KEY=

# Optional: model for chat completions (default: gpt-4o or similar)
# OPENAI_MODEL=gpt-4o

# Optional: model for Responses API / web search (default: gpt-4o)
# OPENAI_RESPONSES_MODEL=gpt-4o
